POSTGRES_DB=novacanvas
POSTGRES_USER=novacanvas
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://novacanvas:replace-with-a-long-random-password@db:5432/novacanvas
APP_URL=https://design.your-company.com
BOOTSTRAP_ADMIN_EMAIL=owner@your-company.com
BOOTSTRAP_ADMIN_PASSWORD=change-to-a-long-random-password
BOOTSTRAP_ADMIN_NAME=Company Owner
# 将密钥放在服务器 .env 文件中，切勿写入前端代码。
OPENAI_API_KEY=
# 官方接口：https://api.openai.com/v1；中转接口填写服务商提供的 Base URL。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
ASSET_DATA_DIR=/app/data
# 可选：腾讯云 COS + CDN。未配置 STORAGE_DRIVER=cos 时，系统继续使用本地 ASSET_DATA_DIR。
STORAGE_DRIVER=local
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
# CDN 加速域名，例如 https://assets.example.com；启用 Type D 鉴权时填写下方鉴权主密钥。
COS_CDN_DOMAIN=
COS_CDN_AUTH_KEY=
